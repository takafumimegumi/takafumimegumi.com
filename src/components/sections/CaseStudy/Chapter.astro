---
import styles from "./Chapter.module.css";

interface Props {
  id: string;
  /** Shown above the heading, in the list of chapters, and in the top bar. */
  title: string;
  heading: string;
  /** The first chapter has no separator above it. */
  first?: boolean;
}

const { id, title, heading, first = false } = Astro.props;
---

{!first && (
  <div class={styles.separator} aria-hidden="true">
    <span class={styles.line} />
    <span class={styles.dot} />
    <span class={styles.line} />
  </div>
)}
<section class={styles.root} id={id} data-chapter={title}>
  <div class={styles.intro}>
    <div>
      <p class={styles.label}>{title}</p>
      <h3 class={styles.heading}>{heading}</h3>
    </div>
    <div class={styles.body}>
      <slot name="intro" />
    </div>
  </div>
  <slot />
</section>
