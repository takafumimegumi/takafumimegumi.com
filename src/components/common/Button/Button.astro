---
import type { HTMLAttributes } from "astro/types";
import styles from "./Button.module.css";

interface Props extends HTMLAttributes<"a"> {
  /** "outline" is the quieter button, for when a filled one follows later. */
  variant?: "filled" | "outline";
}

const { variant = "filled", class: className, ...rest } = Astro.props;
---

<a class:list={[styles.root, className]} data-variant={variant} {...rest}>
  <slot />
</a>
