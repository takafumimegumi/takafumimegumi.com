---
import type { HTMLAttributes } from "astro/types";
import Symbol from "@/components/common/Symbol/Symbol.astro";
import styles from "./TextLink.module.css";

type Props = HTMLAttributes<"a">;

const { class: className, ...rest } = Astro.props;
---

<a class:list={[styles.root, className]} {...rest}>
  <slot />
  <Symbol class={styles.arrow} aria-hidden="true">
    →
  </Symbol>
</a>
