---
import Container from "@/components/common/Container/Container.astro";
import styles from "./SectionHeading.module.css";

interface Props {
  /** The section points to this id with aria-labelledby. */
  id: string;
  width?: "default" | "wide";
}

const { id, width } = Astro.props;
---

<Container width={width}>
  <h2 class={styles.root} id={id} data-reveal>
    <slot />
  </h2>
</Container>
