---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Footer from "@/components/common/Footer/Footer.astro";
import Header from "@/components/common/Header/Header.astro";
import About from "@/components/sections/About/About.astro";
import Contact from "@/components/sections/Contact/Contact.astro";
import Experience from "@/components/sections/Experience/Experience.astro";
import Hero from "@/components/sections/Hero/Hero.astro";
import Projects from "@/components/sections/Projects/Projects.astro";
import Skills from "@/components/sections/Skills/Skills.astro";
import Atras from "@/components/sections/CaseStudy/Atras.astro";
import { projects } from "@/components/sections/Projects/projects";

interface Props {
  /** The slug of the case study to render open. */
  openProject?: string;
}

// The content of each case study, by project slug.
const CASE_STUDIES: Record<string, typeof Atras> = { atras: Atras };

const HOME_TITLE = "Takafumi Megumi";

const { openProject } = Astro.props;
const opened = projects.find((project) => project.slug === openProject);
---

<BaseLayout title={opened?.pageTitle ?? HOME_TITLE}>
  <Header onHome />
  <main id="top">
    <Hero />
    <About />
    <Experience />
    <Projects />
    <Skills />
    <Contact />
  </main>
  <Footer />

  {projects.map((project) => {
    const Content = CASE_STUDIES[project.slug];
    return (
      <Content
        project={project}
        open={project === opened}
        homeTitle={HOME_TITLE}
      />
    );
  })}
</BaseLayout>

<script>
  import "@/scripts/reveal";
</script>
