---
import { Font } from "astro:assets";
import { SITE_NAME } from "@/siteConstants";
import "@/styles/tokens.css";
import "@/styles/base.css";

interface Props {
  title: string;
  description: string;
  /** The path of this page, used for the canonical URL. Leave it out for a page with no URL of its own. */
  path?: string;
  /** A 1200 x 630 image in public/, shown when the page is shared. */
  shareImage: { path: string; alt: string };
}

const { title, description, path, shareImage } = Astro.props;
const canonical = path && new URL(path, Astro.site);
const shareImageUrl = new URL(shareImage.path, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover lets the page paint under the notch; the CSS pads with env(). -->
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- All three weights appear in the first screen, and each file is about 13 kB. -->
    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <slot />
  </body>
</html>

<script>
  import "@/scripts/beacon/sendBeacons";
</script>
