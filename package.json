{
  "name": "takafumimegumi-com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "test": "vitest run",
    "types": "wrangler types --include-runtime=false",
    "report": "node --env-file-if-exists=.env.analytics scripts/report-views.mjs",
    "check": "wrangler types --include-runtime=false --check && prettier --check . && eslint . && stylelint \"src/**/*.css\" && astro check && vitest run && astro build"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/preact": "^6.1.6",
    "@sentry/cloudflare": "^11.12.0",
    "astro": "^7.4.12",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "volta": {
    "node": "24.22.3"
  }
}
