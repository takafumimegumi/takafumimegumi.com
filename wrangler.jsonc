{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "takafumimegumi-com",
  // Wraps the Astro adapter's handler with failure reporting.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-10",

  // The first flag is the Astro adapter's default. The Sentry SDK needs nodejs_compat.
  "compatibility_flags": ["global_fetch_strictly_public", "nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },

  "observability": {
    "enabled": true,
  },

  // Must match OWNER_EMAIL in src/siteConstants.ts (ADR-0006).
  "send_email": [
    { "name": "EMAIL", "destination_address": "tmegumi1103@gmail.com" },
  ],

  // Counted per Cloudflare location (ADR-0006). namespace_id is any number, as a string.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],

  // A version URL writes to this same dataset (ADR-0008).
  "analytics_engine_datasets": [{ "binding": "BEACONS", "dataset": "beacons" }],

  // Names only. The values are entered into Cloudflare directly (ADR-0009).
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GOOGLE_REFRESH_TOKEN",
      "GOOGLE_CALENDAR_ID",
      "TURNSTILE_SECRET_KEY",
      "AVAILABILITY_RULES",
      "SENTRY_DSN",
    ],
  },
}
