{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    // Scripts without imports are still modules, so their top-level names do not collide.
    "moduleDetection": "force"
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
